# Web prod — .env.prod é OPCIONAL.
# Sem arquivo: make prod-up usa defaults do docker-compose.prod.yml
#   rede sharednet + NEXT_PUBLIC_API_URL=https://api.worqera.com
#
# Override sem arquivo:
#   NEXT_PUBLIC_API_URL=https://api.seudominio.com make prod-up
#
# Ou copie este arquivo se preferir fixar no disco:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

NEXT_PUBLIC_API_URL=https://api.worqera.com
NEXT_PUBLIC_APP_NAME=Worqera
NEXT_PUBLIC_MAX_PHOTOS=10
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

WORQERA_DOCKER_NETWORK=sharednet
WORQERA_DOCKER_NETWORK_EXTERNAL=true
