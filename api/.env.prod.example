# Copie para .env.prod (NÃO commitar).
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# Secrets só no host em runtime. A imagem Docker NÃO inclui .env.
# make prod-up / make api-prod-up usa: docker compose --env-file .env.prod …
#
# ---------------------------------------------------------------------------
# Host (uma vez, Oracle / VM) — espelha Procedy:
#   sudo mkdir -p /volumes/worqera/mongodb /volumes/worqera/api/storage
#   sudo chown -R 999:999 /volumes/worqera/mongodb
# Nginx upstream: server worqera-api:80;
# ---------------------------------------------------------------------------
#
# Gerar secrets (cole os valores abaixo):
#   openssl rand -base64 48   # → JWT_SECRET
#   openssl rand -base64 48   # → REFRESH_SECRET
#   openssl rand -hex 32      # → WORQERA_AbacatePay__WebhookSecret (quando ligar)
#
# Conferir tamanho (JWT precisa ser longo):
#   python3 -c "import os; print(len(os.environ.get('JWT_SECRET','')))"

NODE_ENV=production
PORT=80

# ---------------------------------------------------------------------------
# Mongo — hostname INTERNO do compose (sem porta no host)
# URI efetiva é injetada no docker-compose.prod.yml; deixe alinhado.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://worqera-mongodb:27017/worqera?replicaSet=rs0
# Alias aceito pelo código:
# WORQERA_Mongo__Uri=mongodb://worqera-mongodb:27017/worqera?replicaSet=rs0

# ---------------------------------------------------------------------------
# JWT / refresh — OBRIGATÓRIO trocar (openssl rand -base64 48)
# ---------------------------------------------------------------------------
JWT_SECRET=troque-com-openssl-rand-base64-48
JWT_EXPIRES_IN=24h
JWT_EXPIRES=480m
REFRESH_SECRET=troque-com-outro-openssl-rand-base64-48
REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# URLs públicas (links de e-mail / convite / QR / reset)
# Sem barra no final.
# ---------------------------------------------------------------------------
PUBLIC_API_URL=https://api.seudominio.com
PUBLIC_WEB_URL=https://app.seudominio.com

# Platform super-admin (comma-separated, lowercase ok)
PLATFORM_ADMIN_EMAILS=voce@worqera.com

# Rate limits (opcional)
# SIGNUP_RATE_LIMIT_MAX=8
# LOGIN_RATE_LIMIT_MAX=30
# FORGOT_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# E-mail — Gmail App Password (estilo Procedy / early prod)
# Conta Google → 2FA → https://myaccount.google.com/apppasswords
# App: Mail · Outro → Worqera → copiar 16 chars (sem espaços)
# Preferir conta dedicada (noreply / Workspace) a médio prazo.
# ---------------------------------------------------------------------------
WORQERA_Email__Enabled=true
WORQERA_Email__FromName=Worqera
WORQERA_Email__FromAddress=seu-gmail@gmail.com
WORQERA_Email__Smtp__Host=smtp.gmail.com
WORQERA_Email__Smtp__Port=587
WORQERA_Email__Smtp__Username=seu-gmail@gmail.com
WORQERA_Email__Smtp__Password=xxxx-xxxx-xxxx-xxxx
# Aliases aceitos pelo mailer:
# GMAIL_USER=seu-gmail@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# SES opcional (só se PreferSes=true + AWS creds)
# WORQERA_Email__PreferSes=false
# SES_FROM_EMAIL=
# AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# AbacatePay — DESLIGADO por ora (billing manual / estender trial)
# Quando ligar: ApiKey + ProductId + WebhookSecret (openssl rand -hex 32)
# ---------------------------------------------------------------------------
WORQERA_AbacatePay__Enabled=false
WORQERA_AbacatePay__WebhookSecret=ainda-nao-usar
# WORQERA_AbacatePay__ApiKey=
# WORQERA_AbacatePay__ProductId=
# WORQERA_AbacatePay__CheckoutBaseUrl=https://pay.abacatepay.com/checkout
# WORQERA_AbacatePay__ApiBaseUrl=https://api.abacatepay.com/v1

# Storage (path DENTRO do container; volume host em /volumes/worqera/api/storage)
STORAGE_PATH=/app/storage

# Seed em prod — preferir DESLIGADO (rode seed uma vez no host se precisar)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Rede Docker (mesmo padrão Procedy)
# docker network ls → no Oracle atual costuma ser sharednet (nginx/certbot)
# ---------------------------------------------------------------------------
WORQERA_DOCKER_NETWORK=sharednet
WORQERA_DOCKER_NETWORK_EXTERNAL=true
# Se a rede do nginx tiver outro nome, ajuste WORQERA_DOCKER_NETWORK.
# Para compose criar a rede sozinho (lab):
# WORQERA_DOCKER_NETWORK=worqera-prod
# WORQERA_DOCKER_NETWORK_EXTERNAL=false
#
# Mongo: hostname interno worqera-mongodb (sem publish de porta).
# API: container worqera-api, expose 80 (nginx → worqera-api:80).
