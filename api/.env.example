# ==========================================
# WORQERA API — local
# cp .env.example .env   |  Prod: .env.prod.example
# NUNCA commitar .env
# ==========================================

PORT=3001
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/worqera

# JWT (local — em prod use: openssl rand -base64 48)
JWT_SECRET=dev-jwt-secret-change-me-min-32-chars!!
JWT_EXPIRES_IN=24h
JWT_EXPIRES=480m
REFRESH_SECRET=dev-refresh-secret-change-me-too!!
REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

STORAGE_PATH=./uploads
PUBLIC_API_URL=http://127.0.0.1:3001
PUBLIC_WEB_URL=http://127.0.0.1:3000

# Seed Casa do Tênis (make api-seed)
SEED_ADMIN_EMAIL=admin@worqera.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin Casa do Tênis

PLATFORM_ADMIN_EMAILS=admin@worqera.local

# ---------------------------------------------------------------------------
# E-mail (Gmail App Password) — para testar envio real
# 1) Conta Google com 2FA → https://myaccount.google.com/apppasswords
# 2) Preencha user/pass abaixo e WORQERA_Email__Enabled=true
# 3) node scripts/send-test-email.js seu@email.com
# Sem SMTP → só loga no console ([mailer:dev])
# ---------------------------------------------------------------------------
WORQERA_Email__Enabled=false
WORQERA_Email__FromName=Worqera
WORQERA_Email__FromAddress=
WORQERA_Email__Smtp__Host=smtp.gmail.com
WORQERA_Email__Smtp__Port=587
WORQERA_Email__Smtp__Username=
WORQERA_Email__Smtp__Password=
# Aliases ok: GMAIL_USER=  GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# AbacatePay — off no local
# ---------------------------------------------------------------------------
WORQERA_AbacatePay__Enabled=false
WORQERA_AbacatePay__WebhookSecret=dev-webhook-secret
