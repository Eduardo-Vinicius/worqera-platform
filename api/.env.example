# ==========================================
# WORQERA API
# ==========================================

PORT=3001
NODE_ENV=development

# MongoDB (also WORQERA_Mongo__Uri)
MONGODB_URI=mongodb://127.0.0.1:27017/worqera
# WORQERA_Mongo__Uri=mongodb://127.0.0.1:27017/worqera

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h
JWT_EXPIRES=480m
REFRESH_SECRET=your-refresh-secret-here
REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

# Local file storage (default: ./uploads). Optional public base for absolute URLs.
STORAGE_PATH=./uploads
PUBLIC_API_URL=http://127.0.0.1:3001

# Optional: if set, storageService uses S3 instead of local disk
# S3_BUCKET_NAME=
# S3_REGION=us-east-1

# Seed (Casa do Tênis)
SEED_ADMIN_EMAIL=admin@worqera.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin Casa do Tênis

# AbacatePay
WORQERA_AbacatePay__WebhookSecret=change-me-webhook-secret
WORQERA_AbacatePay__CheckoutBaseUrl=https://pay.abacatepay.com/checkout

# ==========================================
# AMAZON SES - EMAIL NOTIFICATIONS
# ==========================================

# Email que aparecerá como remetente
# IMPORTANTE: Este email DEVE estar verificado no Amazon SES Console
# Console: https://console.aws.amazon.com/ses
SES_FROM_EMAIL=noreply@suaempresa.com

# Email para resposta (opcional, se diferente do FROM_EMAIL)
SES_REPLY_TO_EMAIL=contato@suaempresa.com

# ==========================================
# AWS CONFIGURATION
# ==========================================

# Região onde o SES está configurado
# Regiões suportadas: us-east-1, us-west-2, eu-west-1, etc.
AWS_REGION=us-east-1

# Credenciais AWS (NÃO necessário se usar IAM Role em Lambda)
# Mantenha em branco se deployar na AWS Lambda com IAM Role
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# ==========================================
# FUTURE: AWS SNS - SMS NOTIFICATIONS
# ==========================================

# Descomente quando implementar SMS
# SNS_REGION=us-east-1

# ==========================================
# LEGACY Dynamo / S3 (mantidos para compatibilidade)
# ==========================================

# DynamoDB
DYNAMODB_TABLE_CLIENTES=shoe-repair-clientes
DYNAMODB_TABLE_PEDIDOS=shoe-repair-pedidos
DYNAMODB_TABLE_USERS=shoe-repair-users

# S3 para PDFs
# Leave empty for local disk uploads/ (Mongo cutover default)
# S3_BUCKET_NAME=
S3_REGION=us-east-1

# ==========================================
# WHATSAPP (DEPRECATED - não mais usado)
# ==========================================
# Mantido apenas para referência
# WHATSAPP_TOKEN=your-whatsapp-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-id
